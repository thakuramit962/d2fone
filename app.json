{
  "expo": {
    "name": "d2fone",
    "slug": "agriwings",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agriwings",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to take photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select photos.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.bestbringer1.agriwings"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005513",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.bestbringer1.agriwings",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCYzMQ21vV2omOesQVkOUI_acnGu7AkUVM"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005513",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#005513"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Agriwings to use your location to map fields.",
          "locationWhenInUsePermission": "Allow Agriwings to use your location to map fields."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Agriwings to access your camera to capture crop data.",
          "microphonePermission": "Allow Agriwings to access your microphone.",
          "recordAudioAndroid": true
        }
      ],
      "expo-image",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "react-native-compressor",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#286221",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "519e9f71-6457-4113-89ca-d23bbbe4f2a9"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    }
  }
}